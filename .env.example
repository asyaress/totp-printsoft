# PostgreSQL connection from the Vercel Neon integration
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
TOTP_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

TOTP_ADMIN_USER=admin
TOTP_ADMIN_PASSWORD=replace_with_a_long_random_password
TOTP_APP_NAME=Printsoft Secure
